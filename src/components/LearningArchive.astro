---
import Icon from './Icon.astro';
import LearningCard from './LearningCard.astro';
import type { Learning } from '../utils/content';
import { slugify } from '../utils/content';
import { CATEGORIES, SITE } from '../data/site';

interface Props {
  entries: Learning[];
  all: Learning[];
  activeCategory?: string;
}

const { entries, all, activeCategory } = Astro.props;

const counts = new Map<string, number>();
for (const entry of all) {
  counts.set(entry.data.category, (counts.get(entry.data.category) ?? 0) + 1);
}

const filters = [
  { label: 'All', href: '/learnings', count: all.length, active: !activeCategory },
  ...CATEGORIES.filter((category) => counts.has(category)).map((category) => ({
    label: category,
    href: `/learnings/topics/${slugify(category)}`,
    count: counts.get(category) ?? 0,
    active: activeCategory === category,
  })),
];

const busiest = [...counts.entries()].sort((a, b) => b[1] - a[1]);
const total = all.length || 1;
---

<div class="container archive">
  <div class="main">
    <nav class="filters" aria-label="Filter by category">
      {
        filters.map((filter) => (
          <a
            href={filter.href}
            class:list={['filter', { active: filter.active }]}
            aria-current={filter.active ? 'page' : undefined}
          >
            {filter.label} <span class="count">{filter.count}</span>
          </a>
        ))
      }
    </nav>

    {
      entries.length > 0 ? (
        <div class="list">
          {entries.map((entry) => (
            <LearningCard entry={entry} variant="row" />
          ))}
        </div>
      ) : (
        <p class="muted empty">Nothing published in this category yet.</p>
      )
    }
  </div>

  <aside class="side">
    <section class="panel">
      <h2>Writing Frequency</h2>
      <ul class="bars">
        {
          busiest.map(([category, count]) => (
            <li>
              <span class="bar-label">{category}</span>
              <span class="bar-value">
                {count} {count === 1 ? 'post' : 'posts'} ({Math.round((count / total) * 100)}%)
              </span>
              <span class="bar-track">
                <span class="bar-fill" style={`width:${Math.round((count / total) * 100)}%`} />
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="panel feed">
      <p class="eyebrow"><Icon name="rss" size={12} />Stay updated</p>
      <h2>Engineering feed</h2>
      <p class="muted">
        New notes land in the feed as soon as the Markdown is pushed. No newsletter, no tracking.
      </p>
      <a class="btn btn-primary" href="/rss.xml">
        Subscribe via RSS
        <Icon name="arrow-right" size={14} />
      </a>
    </section>

    <section class="panel">
      <h2>Source</h2>
      <p class="muted">
        Every entry on this page is a Markdown file in the site repository.
      </p>
      <a class="link-accent" href={SITE.github} target="_blank" rel="noreferrer noopener">
        Browse the repository
        <Icon name="arrow-up-right" size={14} />
      </a>
    </section>
  </aside>
</div>

<style>
  .archive {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    padding-block: var(--space-xl);
    align-items: start;
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-width: 0;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3125rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    transition:
      border-color 150ms ease,
      color 150ms ease;
  }

  .filter:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .filter.active {
    background: var(--accent-soft);
    border-color: var(--accent-soft-border);
    color: var(--accent-on-soft);
    font-weight: 500;
  }

  .count {
    opacity: 0.65;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .empty {
    padding-block: var(--space-lg);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-width: 0;
  }

  .side .panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-md);
  }

  .side h2 {
    font-size: 0.9375rem;
  }

  .side p {
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .bars {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
    list-style: none;
  }

  .bars li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 0.5rem;
  }

  .bar-label {
    font-size: 0.8125rem;
    color: var(--text);
  }

  .bar-value {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .bar-track {
    grid-column: 1 / -1;
    height: 0.25rem;
    border-radius: var(--radius-full);
    background: var(--surface-high);
    overflow: hidden;
  }

  .bar-fill {
    display: block;
    height: 100%;
    background: var(--accent-bright);
  }

  .feed .eyebrow {
    gap: 0.375rem;
  }

  @media (min-width: 1024px) {
    .archive {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
    .side {
      position: sticky;
      top: calc(var(--header-height) + var(--space-md));
    }
  }
</style>
