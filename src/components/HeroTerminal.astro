---
/**
 * Decorative code panel from the home hero in specs/dev633_home.
 * Static markup on purpose: no highlighter runs on the client.
 */
---

<figure class="terminal" aria-label="Example Java source file, TelemetryBridge.java">
  <figcaption class="bar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="file">TelemetryBridge.java</span>
  </figcaption>

  <pre><code><span class="ln" aria-hidden="true">1</span><span class="an">@Component</span>
<span class="ln" aria-hidden="true">2</span><span class="kw">public class</span> <span class="ty">TelemetryBridge</span> &#123;
<span class="ln" aria-hidden="true">3</span>  <span class="kw">private final</span> MeterRegistry meter;
<span class="ln" aria-hidden="true">4</span>  <span class="an">@EventListener</span>
<span class="ln" aria-hidden="true">5</span>  <span class="kw">public void</span> <span class="fn">onEvent</span>(IngestEvent ev) &#123;
<span class="ln" aria-hidden="true">6</span>    meter.counter(<span class="st">"sys.events"</span>)
<span class="ln" aria-hidden="true">7</span>      .increment();
<span class="ln" aria-hidden="true">8</span>  &#125;
<span class="ln" aria-hidden="true">9</span>&#125;</code></pre>

  <p class="status">
    <span class="live"><span class="pulse" aria-hidden="true"></span>sys.kernel :: ready</span>
    <span>UTF-8 • JVM 21</span>
  </p>
</figure>

<style>
  .terminal {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
    padding: var(--space-md);
    background: #1b1b1e;
    color: #f3f0f4;
    border: 1px solid #2f2f38;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5rem;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid #2f2f38;
  }

  .lights {
    display: inline-flex;
    gap: 0.375rem;
    flex-shrink: 0;
  }

  .lights i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: #ba1a1a;
  }

  .lights i:nth-child(2) {
    background: #6b6579;
  }

  .lights i:nth-child(3) {
    background: #7c3aed;
  }

  .file {
    flex: 1;
    text-align: center;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ccc3d8;
  }

  pre {
    margin: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  code {
    display: block;
    min-width: max-content;
  }

  .ln {
    display: inline-block;
    width: 1.5rem;
    margin-right: 0.75rem;
    text-align: right;
    color: #6b6579;
    user-select: none;
  }

  .an {
    color: #d2bbff;
  }
  .kw {
    color: #e4e0f5;
  }
  .ty {
    color: #ffffff;
    font-weight: 500;
  }
  .fn {
    color: #cbb2ff;
  }
  .st {
    color: #d3bbff;
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: space-between;
    padding-top: var(--space-xs);
    border-top: 1px solid #2f2f38;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: #ccc3d8;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pulse {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background: #7c3aed;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
</style>
