---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';

import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { formatDate, getLearnings, isoDate, readingTime, slugify } from '../../utils/content';

export const getStaticPaths = async () => {
  const entries = await getLearnings();

  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // The list is newest-first, so the newer neighbour sits at index - 1.
      newer: entries[index - 1] ?? null,
      older: entries[index + 1] ?? null,
    },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, newer, older } = Astro.props;
const { title, description, published, updated, category, tags } = entry.data;
const { Content, headings } = await render(entry);

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const editUrl = `${SITE.github}/blob/main/src/content/learnings/${entry.id}.md`;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedAt={published}
  updatedAt={updated}
>
  <div class="container article-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/learnings">Learnings</a>
      <span aria-hidden="true">/</span>
      <span class="current">{title}</span>
    </nav>

    <header class="article-head">
      <p class="chips">
        <a class="chip" href={`/learnings/topics/${slugify(category)}`}>{category}</a>
        {tags.map((tag) => <span class="chip chip-neutral">{tag}</span>)}
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="meta">
        <span class="meta-item">
          <Icon name="calendar" size={13} />
          <time datetime={isoDate(published)}>Published {formatDate(published)}</time>
        </span>
        {
          updated && (
            <span class="meta-item">
              <Icon name="check-circle" size={13} />
              <time datetime={isoDate(updated)}>Updated {formatDate(updated)}</time>
            </span>
          )
        }
        <span class="meta-item">
          <Icon name="clock" size={13} />
          {readingTime(entry.body)}
        </span>
      </p>
    </header>

    <div class="article-body">
      <article class="prose">
        <Content />
      </article>

      <aside class="rail">
        {
          toc.length > 0 && (
            <details class="panel toc" data-toc>
              <summary>
                <Icon name="file-text" size={14} />
                On this page
              </summary>
              <ol>
                {toc.map((heading) => (
                  <li class:list={{ nested: heading.depth === 3 }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        <div class="panel rail-card">
          <p class="rail-title">Share &amp; source</p>
          <a class="link-accent" href={editUrl} target="_blank" rel="noreferrer noopener">
            Edit this page on GitHub
            <Icon name="arrow-up-right" size={14} />
          </a>
        </div>
      </aside>
    </div>

    <nav class="pager" aria-label="More learnings">
      {
        older ? (
          <a class="card pager-link" href={`/learnings/${older.id}`}>
            <span class="pager-label">
              <Icon name="arrow-left" size={13} />
              Previous entry
            </span>
            <span class="pager-title">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a class="card pager-link next" href={`/learnings/${newer.id}`}>
            <span class="pager-label">
              Next entry
              <Icon name="arrow-right" size={13} />
            </span>
            <span class="pager-title">{newer.data.title}</span>
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  .article-shell {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: var(--space-lg) var(--space-xl);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-faint);
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .breadcrumb .current {
    color: var(--text-muted);
  }

  .article-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }

  .article-head h1 {
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .article-head .lede {
    max-width: var(--measure);
  }

  a.chip:hover {
    border-color: var(--accent);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .article-body {
    display: grid;
    /* minmax(0, 1fr) so a wide code block scrolls inside the column
       instead of stretching the grid track past the viewport. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-width: 0;
    order: -1;
  }

  .toc {
    padding: var(--space-md);
  }

  .toc summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    cursor: pointer;
  }

  .toc ol {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-top: var(--space-sm);
    padding-left: 1.125rem;
    font-size: 0.8125rem;
  }

  .toc li::marker {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .toc li.nested {
    padding-left: 0.75rem;
    list-style: none;
  }

  .toc a {
    color: var(--text-muted);
  }

  .toc a:hover {
    color: var(--accent);
  }

  .rail-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-md);
  }

  .rail-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .pager-link {
    gap: var(--space-xs);
    padding: var(--space-md);
  }

  .pager-label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .pager-title {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .pager-link.next {
    text-align: right;
  }

  .pager-link.next .pager-label {
    align-self: flex-end;
  }

  @media (min-width: 640px) {
    .pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .article-head h1 {
      font-size: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .article-body {
      grid-template-columns: minmax(0, 1fr) 16rem;
    }
    .rail {
      order: 0;
      position: sticky;
      top: calc(var(--header-height) + var(--space-md));
    }
    .toc summary {
      pointer-events: none;
    }
    .toc summary::marker,
    .toc summary::-webkit-details-marker {
      display: none;
      content: '';
    }
  }
</style>

<script is:inline>
  // Table of contents starts collapsed on small screens, open on desktop.
  (() => {
    const toc = document.querySelector('[data-toc]');
    if (toc) toc.open = window.matchMedia('(min-width: 1024px)').matches;
  })();
</script>
