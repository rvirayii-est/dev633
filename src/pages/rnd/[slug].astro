---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';

import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRnd } from '../../utils/content';

export const getStaticPaths = async () => {
  const entries = await getRnd();

  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, next: entries[(index + 1) % entries.length] ?? null },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, next } = Astro.props;
const { name, description, status, technologies, github, website } = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={name} description={description} type="article">
  <div class="container shell">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/rnd">R&amp;D</a>
      <span aria-hidden="true">/</span>
      <span class="current">{name}</span>
    </nav>

    <header class="head panel">
      <p class="eyebrow"><span class="dot"></span>{status}</p>
      <h1>{name}</h1>
      <p class="lede">{description}</p>

      <p class="chips">
        {technologies.map((tech) => <span class="chip">{tech}</span>)}
      </p>

      <div class="actions">
        {
          github && (
            <a class="btn btn-secondary" href={github} target="_blank" rel="noreferrer noopener">
              <Icon name="github" size={15} />
              Source
            </a>
          )
        }
        {
          website && (
            <a class="btn btn-primary" href={website} target="_blank" rel="noreferrer noopener">
              Live site
              <Icon name="arrow-up-right" size={14} />
            </a>
          )
        }
      </div>
    </header>

    <div class="body">
      <article class="prose"><Content /></article>

      {
        toc.length > 0 && (
          <aside class="rail">
            <nav class="panel toc" aria-label="Case study sections">
              <p class="rail-title">Sections</p>
              <ol>
                {toc.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
    </div>

    <nav class="pager" aria-label="More projects">
      <a class="link-accent" href="/rnd">
        <Icon name="arrow-left" size={14} />
        Back to all projects
      </a>
      {
        next && next.id !== entry.id && (
          <a class="link-accent" href={`/rnd/${next.id}`}>
            Next project: {next.data.name}
            <Icon name="arrow-right" size={14} />
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  .shell {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: var(--space-lg) var(--space-xl);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-faint);
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .breadcrumb .current {
    color: var(--text-muted);
  }

  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .head h1 {
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .head .lede {
    max-width: var(--measure);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
  }

  .rail {
    min-width: 0;
  }

  .toc {
    padding: var(--space-md);
  }

  .rail-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .toc ol {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-top: var(--space-sm);
    padding-left: 1.125rem;
    font-size: 0.8125rem;
  }

  .toc a {
    color: var(--text-muted);
  }

  .toc a:hover {
    color: var(--accent);
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: space-between;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 768px) {
    .head h1 {
      font-size: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .body {
      grid-template-columns: minmax(0, 1fr) 15rem;
    }
    .rail {
      position: sticky;
      top: calc(var(--header-height) + var(--space-md));
    }
  }
</style>
